# Copy to .env on the deploy host. .env is git-ignored; only this example
# belongs in the repo. See README.md.

# Where contact form messages go. Without it the site still serves every page,
# and the form tells visitors to open a GitHub issue instead.
OWNVAULT_SITE_CONTACT_TO=

# SMTP. HOST and FROM are the two that matter: with HOST unset the server logs
# each composed message instead of sending it, which is right locally and
# wrong in production. FROM must be an identity your provider has verified —
# the visitor's address goes in Reply-To, never in From, because sending as
# someone else's domain fails SPF and burns your own reputation.
#
# For Amazon SES the host is email-smtp.<region>.amazonaws.com and the
# username/password are SES SMTP credentials, which are not IAM access keys.
OWNVAULT_SITE_SMTP_HOST=
OWNVAULT_SITE_SMTP_PORT=587
OWNVAULT_SITE_SMTP_USERNAME=
OWNVAULT_SITE_SMTP_PASSWORD=
OWNVAULT_SITE_SMTP_FROM=

# The demo vault server's public URL, e.g. https://demo.ownvault.example.
# Blank hides every link to the demo, which is the right setting for anyone
# running this site without one. Must include the scheme — the site refuses to
# start otherwise, because a schemeless value becomes a relative link.
OWNVAULT_SITE_DEMO_URL=

# Public origin, e.g. https://ownvault.example. Fills the canonical and og:
# tags, and is what `make smoke` probes after a deploy. Blank skips both.
OVSITE_URL=

# Which image tag runs. Machine-managed — `make deploy` writes it. Don't edit
# by hand.
OVSITE_TAG=
