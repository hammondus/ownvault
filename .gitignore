# build output
/myapp
/ownvault
/dist/

# sync database (SQLite; created next to the executable at runtime)
*.db
*.db-shm
*.db-wal

# local TLS certs (key.pem is private; regenerate with mkcert — see README)
/certs/

# copy of the mkcert root CA, kept locally for setting up new devices
/mkcert-rootCA.crt

# Real configuration. Only .env.example belongs in git.
.env
*.env
!.env.example

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Test directory
/testes/

# Local module development against ../nitrokit. Never a go.mod replace:
# that travels into the deploy build, where the relative path is wrong.
go.work
go.work.sum
