# Copy to .env on the deploy host. .env is git-ignored; only this example
# belongs in the repo. See DEPLOY.md for the full runbook.

# Sync auth token, required: the vaults are ciphertext, but without a token
# anyone who finds the URL can tamper with or delete them. Generate with:
#   openssl rand -hex 16
# Changing it means re-entering it on every synced device (Settings -> sync).
OWNVAULT_TOKEN=

# Staging's token. Optional — blank means staging uses the production token.
# Set it so a token pasted into test devices can never touch production.
OWNVAULT_STAGING_TOKEN=

# Public URLs, used only by `make smoke` / `make smoke-staging` after a
# deploy. Blank skips the check.
OWNVAULT_URL=
OWNVAULT_STAGING_URL=

# Which image tag each instance runs. Machine-managed — `make deploy-staging`
# writes OWNVAULT_STAGING_TAG, `make promote` / `make rollback` write
# OWNVAULT_TAG. Don't edit by hand; `make images` lists what's available.
OWNVAULT_TAG=
OWNVAULT_STAGING_TAG=
